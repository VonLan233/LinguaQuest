PORT=8080
DATABASE_URL=postgresql://linguaquest:change-me@db:5432/linguaquest?sslmode=disable
JWT_SECRET=replace-with-a-long-random-secret
POSTGRES_DB=linguaquest
POSTGRES_USER=linguaquest
POSTGRES_PASSWORD=change-me

# SMTP mail (留空则用 console sender，仅在开发时打印到 stdout)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@linguaquest.app

# AI provider (目前为 mock，填入真实 key 后切换至 remote provider)
AI_PROVIDER=mock
AI_API_KEY=
AI_API_BASE_URL=
AI_DAILY_LIMIT_PER_USER=20

# CORS / API host
API_HOST=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=info
