PORT=8080
DATABASE_URL=postgresql://linguaquest:change-me@db:5432/linguaquest?sslmode=disable
JWT_SECRET=replace-with-a-long-random-secret
POSTGRES_DB=linguaquest
POSTGRES_USER=linguaquest
POSTGRES_PASSWORD=change-me

# SMTP mail (留空则用 console sender，仅在开发时打印到 stdout)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@linguaquest.app

# Resend HTTP API (set RESEND_API_KEY to send real OTP emails; takes priority over SMTP)
RESEND_API_KEY=
# From address for OTP emails (must be a Resend-verified domain), e.g. no-reply@yourdomain.com
MAIL_FROM=no-reply@linguaquest.app

# AI provider: 'mock' (offline), 'opencode' (Zen free via official runtime),
# or 'remote' (direct OpenAI-compatible API requiring a valid API key).
# For production free models, set AI_PROVIDER=opencode in .env.prod.
# The API key is sent only in the Authorization header and is never logged or returned.
AI_PROVIDER=mock
# Only needed for AI_PROVIDER=remote. Never commit a real key.
AI_API_KEY=
AI_API_BASE_URL=https://opencode.ai/inference/openai/v1
AI_MODEL=deepseek-v4.1-flash-free
# Empty uses AI_MODEL for cloze too; do not retain an old paid-model override.
AI_CLOZE_MODEL=
OPENCODE_SERVER_URL=http://opencode:4096
# Set the SAME long random password in .env (Compose) and .env.prod (API).
OPENCODE_SERVER_PASSWORD=
AI_DAILY_LIMIT_PER_USER=20

# CORS / API host
API_HOST=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=info

# ── Production deployment notes ─────────────────────────────────────────────
# Copy to .env.prod and fill in real values
# NEVER commit .env.prod to git
# Use ./deploy/vps_deploy.sh (Compose interpolation uses .env).
